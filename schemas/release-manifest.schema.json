{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Keyflowy/app_release_infrastructure/releases/release-manifest.schema.json",
  "title": "Release manifest",
  "description": "The immutable inventory used by release retention. The planner never infers release semantics from R2 object names.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "product",
    "generated_at",
    "releases"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "product": {
      "type": "string",
      "minLength": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "appcast_object_key": {
      "type": "string",
      "minLength": 1
    },
    "protected_object_keys": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/objectKey"
      },
      "uniqueItems": true
    },
    "appcast_referenced_object_keys": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/objectKey"
      },
      "uniqueItems": true
    },
    "retention_metadata": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/retentionMetadata"
      }
    },
    "releases": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/release"
      }
    }
  },
  "$defs": {
    "objectKey": {
      "type": "string",
      "minLength": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "archive": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "github_release_id",
        "github_asset_id",
        "github_asset_name",
        "github_asset_sha256",
        "github_asset_size_bytes",
        "drive_object_key",
        "drive_sha256",
        "drive_size_bytes",
        "verified"
      ],
      "properties": {
        "github_release_id": {"type": ["integer", "string"]},
        "github_asset_id": {"type": ["integer", "string"]},
        "github_asset_name": {"type": "string", "minLength": 1},
        "github_asset_sha256": {"$ref": "#/$defs/sha256"},
        "github_asset_digest": {"$ref": "#/$defs/sha256"},
        "github_asset_size_bytes": {"type": "integer", "minimum": 1},
        "drive_object_key": {"$ref": "#/$defs/objectKey"},
        "drive_sha256": {"$ref": "#/$defs/sha256"},
        "drive_md5": {"type": "string", "pattern": "^[0-9a-fA-F]{32}$"},
        "drive_size_bytes": {"type": "integer", "minimum": 1},
        "verified": {"type": "boolean"}
      }
    },
    "metadataBackup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["drive_object_key", "sha256", "size_bytes", "verified"],
      "properties": {
        "drive_object_key": {"$ref": "#/$defs/objectKey"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "md5": {"type": "string", "pattern": "^[0-9a-fA-F]{32}$"},
        "size_bytes": {"type": "integer", "minimum": 1},
        "verified": {"type": "boolean"}
      }
    },
    "metadataCompletion": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "evidence_version": {"enum": [1, 2]},
        "git_path": {"type": "string", "minLength": 1},
        "git_commit": {"type": "string", "pattern": "^[0-9a-fA-F]{40,64}$"},
        "zip_sha256": {"$ref": "#/$defs/sha256"},
        "manifest_path": {"$ref": "#/$defs/objectKey"},
        "manifest_entry_sha256": {"$ref": "#/$defs/sha256"},
        "path": {"type": "string", "minLength": 1},
        "commit": {"type": "string", "pattern": "^[0-9a-fA-F]{40,64}$"},
        "verified": {"type": "boolean"}
      },
      "required": ["verified"],
      "allOf": [
        {
          "anyOf": [
            {"required": ["git_path", "git_commit"]},
            {"required": ["path", "commit"]}
          ]
        },
        {
          "if": {
            "properties": {"evidence_version": {"const": 2}},
            "required": ["evidence_version"]
          },
          "then": {
            "required": [
              "git_path",
              "git_commit",
              "zip_sha256",
              "manifest_path",
              "manifest_entry_sha256"
            ],
            "not": {
              "anyOf": [
                {"required": ["path"]},
                {"required": ["commit"]}
              ]
            }
          },
          "else": {
            "not": {
              "anyOf": [
                {"required": ["zip_sha256"]},
                {"required": ["manifest_path"]},
                {"required": ["manifest_entry_sha256"]}
              ]
            }
          }
        }
      ]
    },
    "retentionMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["object_key", "release_date", "checksum", "size_bytes"],
      "properties": {
        "object_key": {"$ref": "#/$defs/objectKey"},
        "release_date": {"type": "string", "format": "date"},
        "checksum": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 1},
        "backup": {"$ref": "#/$defs/metadataBackup"},
        "drive_backup": {"$ref": "#/$defs/metadataBackup"},
        "completion": {"$ref": "#/$defs/metadataCompletion"},
        "git_completion_tombstone": {"$ref": "#/$defs/metadataCompletion"}
      },
      "allOf": [
        {"anyOf": [{"required": ["backup"]}, {"required": ["drive_backup"]}]},
        {"anyOf": [{"required": ["completion"]}, {"required": ["git_completion_tombstone"]}]}
      ]
    },
    "releaseCompletion": {
      "allOf": [
        {"$ref": "#/$defs/metadataCompletion"},
        {
          "type": "object",
          "properties": {
            "evidence_version": {"const": 2},
            "verified": {"const": true}
          },
          "required": [
            "evidence_version",
            "git_path",
            "git_commit",
            "zip_sha256",
            "manifest_path",
            "manifest_entry_sha256",
            "verified"
          ]
        }
      ]
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "feature_line",
        "release_date",
        "channel",
        "notarization_status",
        "full_zip_object_key",
        "sparkle_delta_object_keys"
      ],
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
        },
        "feature_line": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "release_date": {
          "type": "string",
          "format": "date"
        },
        "channel": {
          "enum": [
            "stable",
            "prerelease"
          ]
        },
        "notarization_status": {
          "enum": [
            "notarized",
            "pending",
            "failed"
          ]
        },
        "fallback": {
          "type": "boolean",
          "default": false
        },
        "full_zip_object_key": {
          "$ref": "#/$defs/objectKey"
        },
        "checksum": {
          "type": "string",
          "minLength": 1
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "archive": {
          "$ref": "#/$defs/archive"
        },
        "completion": {
          "$ref": "#/$defs/releaseCompletion"
        },
        "checksum_object_key": {
          "$ref": "#/$defs/objectKey"
        },
        "signature_object_key": {
          "$ref": "#/$defs/objectKey"
        },
        "sparkle_delta_object_keys": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/objectKey"
          },
          "uniqueItems": true
        }
      }
    }
  }
}
