{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Keyflowy/app_release_infrastructure/releases/release-retention-metadata.schema.json",
  "title": "Release retention metadata",
  "description": "Per-version release-state metadata stored at <retention_metadata_dir>/vX.Y.Z/metadata.json. The version must equal the directory name without the leading v, and every object_key must live under <prefix>/release-state/vX.Y.Z/.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "version",
    "retention_metadata"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "retention_metadata": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/retentionMetadata"
      }
    }
  },
  "$defs": {
    "objectKey": {
      "type": "string",
      "minLength": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "metadataBackup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["drive_object_key", "sha256", "size_bytes", "verified"],
      "properties": {
        "drive_object_key": {"$ref": "#/$defs/objectKey"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "md5": {"type": "string", "pattern": "^[0-9a-fA-F]{32}$"},
        "size_bytes": {"type": "integer", "minimum": 1},
        "verified": {"type": "boolean"}
      }
    },
    "metadataCompletion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_version",
        "git_path",
        "git_commit",
        "zip_sha256",
        "manifest_path",
        "manifest_entry_sha256",
        "verified"
      ],
      "properties": {
        "evidence_version": {"const": 3},
        "git_path": {"type": "string", "minLength": 1},
        "git_commit": {"type": "string", "pattern": "^[0-9a-fA-F]{40,64}$"},
        "zip_sha256": {"$ref": "#/$defs/sha256"},
        "manifest_path": {"$ref": "#/$defs/objectKey"},
        "manifest_entry_sha256": {"$ref": "#/$defs/sha256"},
        "verified": {"type": "boolean"}
      }
    },
    "retentionMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["object_key", "release_date", "checksum", "size_bytes", "completion"],
      "properties": {
        "object_key": {"$ref": "#/$defs/objectKey"},
        "release_date": {"type": "string", "format": "date"},
        "checksum": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 1},
        "backup": {"$ref": "#/$defs/metadataBackup"},
        "drive_backup": {"$ref": "#/$defs/metadataBackup"},
        "completion": {"$ref": "#/$defs/metadataCompletion"}
      },
      "anyOf": [
        {"required": ["backup"]},
        {"required": ["drive_backup"]}
      ]
    }
  }
}
